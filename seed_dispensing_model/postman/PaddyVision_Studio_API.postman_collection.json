{
  "info": {
    "_postman_id": "dbe88b66-91a5-4a3a-93cb-3cfbcdf31cc0",
    "name": "PaddyVision Studio API",
    "description": "Postman collection for the FastAPI endpoints used by the PaddyVision Studio frontend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
