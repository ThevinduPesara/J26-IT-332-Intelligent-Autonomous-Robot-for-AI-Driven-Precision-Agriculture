{
  "info": {
    "_postman_id": "106dd6df-6f90-47eb-9f82-a32480f61ee8",
    "name": "NutrientOS Frontend API",
    "description": "Only the API endpoints called by the NutrientOS Streamlit frontend: GET /health and POST /api/v1/calculate. Start the FastAPI backend before sending requests. Research/simulation only; no request controls a physical pump.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8071",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "GET Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": "Called by the frontend to check whether the API is online."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Reports simulation-only mode', function () {",
              "    pm.expect(pm.response.json().simulation_only).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST Calculate & analyze",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"plot\": {\n    \"area\": 10,\n    \"unit\": \"m2\",\n    \"plants\": 20,\n    \"stage_week\": 4,\n    \"transplant_date\": null\n  },\n  \"soil\": {\n    \"n_mgkg\": 80,\n    \"p_mgkg\": 12,\n    \"k_mgkg\": 90,\n    \"ph\": 6.3,\n    \"origin\": \"SIMULATED\"\n  },\n  \"liquid\": {\n    \"label_n_percent\": 5,\n    \"label_p2o5_percent\": 5,\n    \"label_k2o_percent\": 5,\n    \"density_g_ml\": 1.1,\n    \"dilution_factor\": 1\n  },\n  \"calculation_mode\": \"reference\",\n  \"calibration\": {\n    \"n_kg_ha_per_mgkg\": null,\n    \"p2o5_kg_ha_per_mgkg\": null,\n    \"k2o_kg_ha_per_mgkg\": null,\n    \"provenance\": \"\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/calculate",
        "description": "Matches the frontend's default payload structure. Change values to match the controls in the Streamlit UI. This API returns a research/reference calculation, not an authorized fertilizer application."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns a calculation result', function () {",
              "    pm.expect(pm.response.json().reference.schedule).to.be.an('array');",
              "    pm.expect(pm.response.json().mode).to.eql('reference');",
              "});",
              "pm.test('Does not enable pump actuation', function () {",
              "    pm.expect(pm.response.json().modelled.liquid_comparison).to.eql(null);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
